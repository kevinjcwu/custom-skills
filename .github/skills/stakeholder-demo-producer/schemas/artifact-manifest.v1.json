{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "artifact-manifest.v1",
	"title": "Artifact manifest",
	"description": "Every artifact of a run with its relative path, byte size and SHA-256, plus transformations, failures and cleanup.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"runId",
		"subject",
		"status",
		"catalogSha256",
		"storyboardSha256",
		"authorizationSha256",
		"targetContentSha256",
		"artifacts",
		"transformations",
		"failures",
		"cleanup"
	],
	"properties": {
		"schema": {
			"const": "artifact-manifest.v1"
		},
		"runId": {
			"$ref": "#/$defs/runId"
		},
		"subject": {
			"type": "string",
			"enum": ["synthetic-fixture", "target"]
		},
		"status": {
			"type": "string",
			"enum": ["completed", "failed", "cancelled"]
		},
		"catalogSha256": {
			"$ref": "#/$defs/sha256"
		},
		"storyboardSha256": {
			"$ref": "#/$defs/sha256"
		},
		"authorizationSha256": {
			"$ref": "#/$defs/sha256"
		},
		"targetContentSha256": {
			"$ref": "#/$defs/sha256"
		},
		"artifacts": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["path", "sha256", "bytes", "role", "producedBy"],
				"properties": {
					"path": {
						"$ref": "#/$defs/relativePath"
					},
					"sha256": {
						"$ref": "#/$defs/sha256"
					},
					"bytes": {
						"type": "integer",
						"minimum": 0
					},
					"role": {
						"type": "string",
						"enum": [
							"catalog",
							"storyboard",
							"authorization",
							"events",
							"stdout",
							"stderr",
							"http-body",
							"page-text",
							"screenshot",
							"browser-video",
							"service-log",
							"workspace-output",
							"export-video",
							"export-audio",
							"captions",
							"diagram",
							"log",
							"helper",
							"helper-transcript",
							"helper-result",
							"helper-media"
						]
					},
					"producedBy": {
						"$ref": "#/$defs/id"
					},
					"from": {
						"type": "array",
						"uniqueItems": true,
						"items": {
							"$ref": "#/$defs/relativePath"
						}
					}
				}
			}
		},
		"transformations": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["artifact", "kind", "count", "detail"],
				"properties": {
					"artifact": {
						"$ref": "#/$defs/relativePath"
					},
					"kind": {
						"type": "string",
						"enum": ["redact-bindings"]
					},
					"count": {
						"type": "integer",
						"minimum": 0
					},
					"detail": {
						"$ref": "#/$defs/text"
					}
				}
			}
		},
		"failures": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["code", "message"],
				"properties": {
					"code": {
						"$ref": "#/$defs/id"
					},
					"message": {
						"$ref": "#/$defs/text"
					},
					"sceneId": {
						"$ref": "#/$defs/id"
					},
					"actionId": {
						"$ref": "#/$defs/id"
					}
				}
			}
		},
		"cleanup": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["item", "result", "detail"],
				"properties": {
					"item": {
						"$ref": "#/$defs/text"
					},
					"result": {
						"type": "string",
						"enum": [
							"removed",
							"terminated",
							"exited",
							"closed",
							"retained",
							"failed"
						]
					},
					"detail": {
						"$ref": "#/$defs/text"
					}
				}
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
		},
		"sha256": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"text": {
			"type": "string",
			"minLength": 1,
			"maxLength": 4000
		},
		"relativePath": {
			"type": "string",
			"maxLength": 4096,
			"x-sdp-path": "relative"
		},
		"runId": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
		}
	}
}
