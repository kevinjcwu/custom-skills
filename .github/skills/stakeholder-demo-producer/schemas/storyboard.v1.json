{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "storyboard.v1",
	"title": "Storyboard",
	"description": "One user journey told for one or more audiences. Narration may only cite claims, and claims must resolve to catalog evidence or to demonstrating actions.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"catalogSha256",
		"title",
		"goal",
		"audiences",
		"confidentiality",
		"clarifications",
		"dataProvenance",
		"claims",
		"scenes"
	],
	"properties": {
		"schema": {
			"const": "storyboard.v1"
		},
		"catalogSha256": {
			"$ref": "#/$defs/sha256"
		},
		"title": {
			"$ref": "#/$defs/text"
		},
		"goal": {
			"$ref": "#/$defs/text"
		},
		"audiences": {
			"type": "array",
			"minItems": 1,
			"maxItems": 2,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"enum": ["business", "engineering"]
			}
		},
		"confidentiality": {
			"type": "object",
			"additionalProperties": false,
			"required": ["onScreen", "exportAudience"],
			"properties": {
				"onScreen": {
					"type": "string",
					"enum": ["synthetic-only", "approved-repository-content"]
				},
				"exportAudience": {
					"$ref": "#/$defs/text"
				}
			}
		},
		"clarifications": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "question", "answer", "source"],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"question": {
						"$ref": "#/$defs/text"
					},
					"answer": {
						"$ref": "#/$defs/text"
					},
					"source": {
						"type": "string",
						"enum": ["human", "default-assumption"]
					}
				}
			}
		},
		"dataProvenance": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "kind", "description", "rightsConfirmed"],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"kind": {
						"type": "string",
						"enum": [
							"synthetic",
							"repo-fixture",
							"human-supplied",
							"forbidden"
						]
					},
					"description": {
						"$ref": "#/$defs/text"
					},
					"rightsConfirmed": {
						"type": "boolean"
					}
				}
			}
		},
		"claims": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "text", "class", "evidence", "demonstratedBy"],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"text": {
						"$ref": "#/$defs/text"
					},
					"class": {
						"$ref": "#/$defs/evidenceClass"
					},
					"evidence": {
						"$ref": "#/$defs/idList"
					},
					"demonstratedBy": {
						"$ref": "#/$defs/idList"
					},
					"capability": {
						"$ref": "#/$defs/id"
					}
				}
			}
		},
		"scenes": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"id",
					"title",
					"adapter",
					"capabilities",
					"dataProvenance",
					"actions",
					"expect",
					"narration"
				],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"title": {
						"$ref": "#/$defs/text"
					},
					"adapter": {
						"type": "string",
						"enum": ["process", "http", "browser"]
					},
					"capabilities": {
						"$ref": "#/$defs/idList"
					},
					"dataProvenance": {
						"$ref": "#/$defs/idList"
					},
					"actions": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["id", "op"],
							"properties": {
								"id": {
									"$ref": "#/$defs/id"
								},
								"op": {
									"type": "string",
									"enum": [
										"run",
										"request",
										"goto",
										"click",
										"fill",
										"press",
										"wait",
										"helper"
									]
								},
								"ref": {
									"$ref": "#/$defs/id"
								},
								"target": {
									"$ref": "#/$defs/text"
								},
								"value": {
									"type": "string",
									"maxLength": 4000
								}
							}
						}
					},
					"expect": {
						"type": "array",
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["id", "action", "check", "value"],
							"properties": {
								"id": {
									"$ref": "#/$defs/id"
								},
								"action": {
									"$ref": "#/$defs/id"
								},
								"check": {
									"type": "string",
									"enum": [
										"exitCode",
										"stdoutIncludes",
										"stderrIncludes",
										"status",
										"bodyIncludes",
										"pageIncludes",
										"pageExcludes",
										"pageIncludesNew"
									]
								},
								"value": {
									"type": ["string", "integer"],
									"minLength": 1,
									"maxLength": 4000
								}
							}
						}
					},
					"narration": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["id", "audience", "text", "claims", "caption"],
							"properties": {
								"id": {
									"$ref": "#/$defs/id"
								},
								"audience": {
									"type": "string",
									"enum": ["business", "engineering"]
								},
								"text": {
									"type": "string",
									"minLength": 1,
									"maxLength": 2000
								},
								"claims": {
									"type": "array",
									"minItems": 1,
									"uniqueItems": true,
									"items": {
										"$ref": "#/$defs/id"
									}
								},
								"caption": {
									"type": "object",
									"additionalProperties": false,
									"required": ["source", "provenance"],
									"properties": {
										"source": {
											"const": "narration-text"
										},
										"provenance": {
											"type": "string",
											"enum": [
												"agent-drafted",
												"human-authored",
												"human-approved"
											]
										}
									}
								}
							}
						}
					},
					"diagram": {
						"type": "object",
						"additionalProperties": false,
						"required": ["edges", "caption"],
						"properties": {
							"edges": {
								"type": "array",
								"minItems": 1,
								"uniqueItems": true,
								"items": {
									"$ref": "#/$defs/id"
								}
							},
							"caption": {
								"$ref": "#/$defs/text"
							}
						}
					}
				}
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
		},
		"idList": {
			"type": "array",
			"uniqueItems": true,
			"maxItems": 1000,
			"items": {
				"$ref": "#/$defs/id"
			}
		},
		"sha256": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"text": {
			"type": "string",
			"minLength": 1,
			"maxLength": 4000
		},
		"evidenceClass": {
			"type": "string",
			"enum": [
				"fact",
				"observed",
				"source-backed",
				"documented",
				"inferred",
				"unknown"
			]
		}
	}
}
