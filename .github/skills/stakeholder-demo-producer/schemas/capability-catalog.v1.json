{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "capability-catalog.v1",
	"title": "Capability catalog",
	"description": "Evidence-backed inventory of a repository plus agent-authored capabilities. Inventory entries are helper-observed file facts; capabilities, components and edges carry an explicit evidence class.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema",
		"generatedBy",
		"repo",
		"evidence",
		"inventory",
		"runCommands",
		"platforms",
		"capabilities",
		"components",
		"edges",
		"forbiddenClaims",
		"unknowns",
		"skipped"
	],
	"properties": {
		"schema": {
			"const": "capability-catalog.v1"
		},
		"generatedBy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["tool", "contractVersion"],
			"properties": {
				"tool": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				},
				"contractVersion": {
					"const": "1"
				}
			}
		},
		"repo": {
			"type": "object",
			"description": "Identity of the discovered tree. No absolute root path is stored.",
			"additionalProperties": false,
			"required": ["label", "contentSha256", "fileCount", "skippedCount"],
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200
				},
				"contentSha256": {
					"$ref": "#/$defs/sha256"
				},
				"fileCount": {
					"type": "integer",
					"minimum": 0
				},
				"skippedCount": {
					"type": "integer",
					"minimum": 0
				}
			}
		},
		"evidence": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "kind", "ref", "sha256"],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"kind": {
						"type": "string",
						"enum": [
							"manifest",
							"source",
							"test",
							"doc",
							"config-example",
							"ci",
							"run-artifact"
						]
					},
					"ref": {
						"type": "object",
						"additionalProperties": false,
						"required": ["path"],
						"properties": {
							"path": {
								"$ref": "#/$defs/relativePath"
							},
							"lines": {
								"type": "object",
								"additionalProperties": false,
								"required": ["start", "end"],
								"properties": {
									"start": {
										"type": "integer",
										"minimum": 1
									},
									"end": {
										"type": "integer",
										"minimum": 1
									}
								}
							}
						}
					},
					"sha256": {
						"$ref": "#/$defs/sha256"
					},
					"runId": {
						"$ref": "#/$defs/runId"
					}
				}
			}
		},
		"inventory": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"manifests",
				"entryPoints",
				"tests",
				"docs",
				"configExampleKeys",
				"signals"
			],
			"properties": {
				"manifests": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["evidence", "kind"],
						"properties": {
							"evidence": {
								"$ref": "#/$defs/id"
							},
							"kind": {
								"type": "string",
								"minLength": 1,
								"maxLength": 64
							}
						}
					}
				},
				"entryPoints": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["evidence", "kind", "name"],
						"properties": {
							"evidence": {
								"$ref": "#/$defs/id"
							},
							"kind": {
								"type": "string",
								"enum": [
									"html-page",
									"bin",
									"main",
									"server-candidate",
									"cli-candidate"
								]
							},
							"name": {
								"$ref": "#/$defs/text"
							}
						}
					}
				},
				"tests": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["evidence", "titles"],
						"properties": {
							"evidence": {
								"$ref": "#/$defs/id"
							},
							"titles": {
								"type": "array",
								"maxItems": 500,
								"items": {
									"$ref": "#/$defs/text"
								}
							}
						}
					}
				},
				"docs": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["evidence", "headings"],
						"properties": {
							"evidence": {
								"$ref": "#/$defs/id"
							},
							"headings": {
								"type": "array",
								"maxItems": 500,
								"items": {
									"$ref": "#/$defs/text"
								}
							}
						}
					}
				},
				"configExampleKeys": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["evidence", "names"],
						"properties": {
							"evidence": {
								"$ref": "#/$defs/id"
							},
							"names": {
								"type": "array",
								"maxItems": 500,
								"items": {
									"type": "string",
									"pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
								}
							}
						}
					}
				},
				"signals": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["evidence", "signal", "line"],
						"properties": {
							"evidence": {
								"$ref": "#/$defs/id"
							},
							"signal": {
								"type": "string",
								"minLength": 1,
								"maxLength": 64
							},
							"line": {
								"type": "integer",
								"minimum": 1
							}
						}
					}
				}
			}
		},
		"runCommands": {
			"type": "array",
			"items": {
				"type": "object",
				"description": "Commands declared by the repository. Discovery never executes them.",
				"additionalProperties": false,
				"required": ["id", "evidence", "name", "command", "executed"],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"evidence": {
						"$ref": "#/$defs/id"
					},
					"name": {
						"$ref": "#/$defs/text"
					},
					"command": {
						"$ref": "#/$defs/text"
					},
					"executed": {
						"const": false
					}
				}
			}
		},
		"platforms": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "name", "class", "evidence"],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"name": {
						"$ref": "#/$defs/text"
					},
					"class": {
						"$ref": "#/$defs/evidenceClass"
					},
					"evidence": {
						"$ref": "#/$defs/idList"
					},
					"reason": {
						"$ref": "#/$defs/text"
					}
				}
			}
		},
		"capabilities": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"id",
					"title",
					"class",
					"provenance",
					"evidence",
					"userVisible"
				],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"title": {
						"$ref": "#/$defs/text"
					},
					"class": {
						"$ref": "#/$defs/evidenceClass"
					},
					"provenance": {
						"type": "string",
						"enum": ["inventory", "agent"]
					},
					"evidence": {
						"$ref": "#/$defs/idList"
					},
					"userVisible": {
						"type": "boolean"
					},
					"platform": {
						"$ref": "#/$defs/id"
					},
					"reason": {
						"$ref": "#/$defs/text"
					}
				}
			}
		},
		"components": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "name", "kind", "evidence"],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"name": {
						"$ref": "#/$defs/text"
					},
					"kind": {
						"type": "string",
						"enum": [
							"ui",
							"cli",
							"service",
							"library",
							"data",
							"test",
							"external",
							"unknown"
						]
					},
					"evidence": {
						"$ref": "#/$defs/idList"
					}
				}
			}
		},
		"edges": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "from", "to", "label", "class", "evidence"],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"from": {
						"$ref": "#/$defs/id"
					},
					"to": {
						"$ref": "#/$defs/id"
					},
					"label": {
						"$ref": "#/$defs/text"
					},
					"class": {
						"$ref": "#/$defs/evidenceClass"
					},
					"evidence": {
						"$ref": "#/$defs/idList"
					}
				}
			}
		},
		"forbiddenClaims": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "pattern", "reason"],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"pattern": {
						"type": "string",
						"minLength": 1,
						"maxLength": 500
					},
					"reason": {
						"$ref": "#/$defs/text"
					}
				}
			}
		},
		"unknowns": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "question", "impact"],
				"properties": {
					"id": {
						"$ref": "#/$defs/id"
					},
					"question": {
						"$ref": "#/$defs/text"
					},
					"impact": {
						"$ref": "#/$defs/text"
					}
				}
			}
		},
		"skipped": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["path", "reason"],
				"properties": {
					"path": {
						"$ref": "#/$defs/relativePath"
					},
					"reason": {
						"type": "string",
						"enum": [
							"denied",
							"ignored",
							"symlink",
							"too-large",
							"limit",
							"special",
							"unsupported-name",
							"unreadable",
							"demo-skill"
						]
					}
				}
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
		},
		"idList": {
			"type": "array",
			"uniqueItems": true,
			"maxItems": 1000,
			"items": {
				"$ref": "#/$defs/id"
			}
		},
		"sha256": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"text": {
			"type": "string",
			"minLength": 1,
			"maxLength": 4000
		},
		"relativePath": {
			"type": "string",
			"maxLength": 4096,
			"x-sdp-path": "relative"
		},
		"evidenceClass": {
			"type": "string",
			"enum": [
				"fact",
				"observed",
				"source-backed",
				"documented",
				"inferred",
				"unknown"
			]
		},
		"runId": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
		}
	}
}
